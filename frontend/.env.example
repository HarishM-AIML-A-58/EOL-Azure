# Optional. Leave unset for the standard monolith deployment, where FastAPI
# serves this bundle and the API is same-origin.
#
# Set it only when the frontend is hosted separately from the API. That
# deployment must also add this origin to ALLOWED_ORIGINS on the backend,
# otherwise the session cookie will be rejected.
# VITE_API_BASE_URL=https://your-api-host.azurewebsites.net
