# Backend configuration. Copy to .env for local development; on Azure App
# Service set these as Application Settings instead of shipping a file.

# --- Distributor APIs ------------------------------------------------------
OCTOPART_CLIENT_ID=
OCTOPART_CLIENT_SECRET=
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
MOUSER_API_KEY=

# --- Azure OpenAI (FFF classification) -------------------------------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# --- Runtime ---------------------------------------------------------------
# "production" makes the session cookie Secure + SameSite=None. Requires HTTPS.
ENV=development

# Durable storage. On Azure App Service (Linux) only /home survives a redeploy.
# DATA_DIR=/home/data
# REPORTS_DIR=/home/data/reports

# Extra browser origins allowed to call the API. Only needed when the frontend
# is hosted separately; the monolith deployment is same-origin.
# ALLOWED_ORIGINS=http://localhost:5173
